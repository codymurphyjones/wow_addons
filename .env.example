# Copy to .env (gitignored) and fill in. Real environment variables override these.

# CurseForge Core API key - console.curseforge.com
CURSEFORGE_KEY=

# Author upload token, only needed for `yarn deploy` - authors.curseforge.com -> API Tokens
CURSEFORGE_UPLOAD_TOKEN=

# Your CurseForge username - deploy refuses to upload to projects you don't own
CURSEFORGE_AUTHOR=

# WoW folder, a game-version folder, or its AddOns folder, e.g.
# C:/Program Files (x86)/World of Warcraft/_classic_era_
WOW_INSTALL=

# Optional, for `yarn deploy:pages` (tools/curseforge): your GitHub sign-in for CurseForge.
# Leave the password out to be asked for it in the terminal each time you need to sign in.
GITHUB_USERNAME=
