.env
.addon_sync/
__pycache__/
node_modules/
yarn.lock

# The build tools' datasets are kept packed (tools/<Addon>/<folder>.tar.xz, tracked); the folders
# only exist while a build runs (tools/datasets.py, tools/build_all.py).
tools/*/.wowhead_cache/
tools/*/.cache/
tools/*/*.tar.xz.tmp

# Signed-in browser profile for tools/curseforge/update_descriptions.py.
tools/curseforge/.profile/
